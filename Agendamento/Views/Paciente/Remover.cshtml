@model Agendamento.Models.Paciente

@{
    ViewData["Title"] = "Remover paciente";
}

<h1>Remover paciente</h1>
<p>Confirma a remoção deste paciente?</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">CPF</dt>
    <dd class="col-sm-9">@Model.Cpf</dd>
    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>
    <dt class="col-sm-3">Endereço</dt>
    <dd class="col-sm-9">@Model.Endereco</dd>
    <dt class="col-sm-3">Data de nascimento</dt>
    <dd class="col-sm-9">@Model.DataNascimento?.ToString("dd/MM/yyyy")</dd>
</dl>

<form asp-action="Remover" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Confirmar remoção</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
